{% extends 'base.html.twig' %}

{% block title %}Liste des Tuteurs{% endblock %}

{% block body %}
<div class="container my-5">
    <!-- En-tête -->
    <div class="row mb-4">
        <div class="col">
            <h1 class="fw-bold">
                <i class="bi bi-people-fill text-primary me-2"></i>
                Liste des Tuteurs
            </h1>
            <p class="text-muted">Parcourez notre liste de tuteurs qualifiés</p>
        </div>
        <div class="col-auto">
            <span class="badge bg-primary fs-6 px-3 py-2">
                {{ tuteurs|length }} tuteur{{ tuteurs|length > 1 ? 's' : '' }}
            </span>
        </div>
    </div>

    <!-- Tableau responsive avec card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3">
                                {% set newOrder = app.request.get('order') == 'asc' ? 'desc' : 'asc' %}
                                <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all | merge({ sort: 'nom', order: newOrder })) }}" 
                                   class="text-decoration-none text-dark fw-semibold">
                                    Nom
                                    {% if app.request.get('sort') == 'nom' %}
                                        {% if app.request.get('order') == 'asc' %}
                                            <i class="bi bi-arrow-up"></i>
                                        {% else %}
                                            <i class="bi bi-arrow-down"></i>
                                        {% endif %}
                                    {% else %}
                                        <i class="bi bi-arrow-down-up text-muted small"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th class="py-3">Prénom</th>
                            <th class="py-3">Entreprise</th>
                            <th class="py-3">Email</th>
                            <th class="py-3">Téléphone</th>
                            <th class="py-3 text-center">
                                <i class="bi bi-person-badge me-1"></i>Étudiants
                            </th>
                            <th class="py-3 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for t in tuteurs %}
                        <tr>
                            <td class="px-4 py-3">
                                <span class="fw-semibold">{{ t.nom }}</span>
                            </td>
                            <td class="py-3">{{ t.prenom }}</td>
                            <td class="py-3">
                                {% if t.entreprise %}
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-building me-1"></i>{{ t.entreprise }}
                                    </span>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td class="py-3">
                                <a href="mailto:{{ t.email }}" class="text-decoration-none">
                                    <i class="bi bi-envelope me-1"></i>{{ t.email }}
                                </a>
                            </td>
                            <td class="py-3">
                                <i class="bi bi-telephone me-1 text-muted"></i>{{ t.telephone }}
                            </td>
                            <td class="py-3 text-center">
                                <span class="badge bg-primary rounded-pill">
                                    {{ t.etudiants|length }}
                                </span>
                            </td>
                            <td class="py-3 text-center">
                                <a href="{{ path('app_tuteur_show', { id: t.id }) }}" 
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i>Voir
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                    <p class="mb-0">Aucun tuteur disponible pour le moment</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}