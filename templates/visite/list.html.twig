{% extends 'base.html.twig' %}

{% block body %}
<div class="container my-5">
    
    {# En-tête #}
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Visites</li>
                </ol>
            </nav>
            <h1 class="fw-bold mb-2">
                <i class="bi bi-calendar-check text-primary me-2"></i>
                Visites de {{ etudiant.prenom }} {{ etudiant.nom }}
            </h1>
            <p class="text-muted">Gérez les visites et comptes rendus de cet étudiant</p>
        </div>
        <div class="col-auto align-self-end">
            <a href="{{ path('visite_add', {'id': etudiant.id}) }}" class="btn btn-success">
                <i class="bi bi-plus-circle me-2"></i>Ajouter une visite
            </a>
        </div>
    </div>

    {# Filtres #}
    {% include 'partials/visite/_filters.html.twig' with {
        statut: statut ?? 'Toutes',
        etudiant: etudiant
    } %}

    {# Tableau des visites #}
    <div class="card shadow-sm border-0 mt-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">
                <i class="bi bi-list-ul text-primary me-2"></i>
                Liste des visites
                <span class="badge bg-primary rounded-pill ms-2">{{ visites|length }}</span>
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3">Date</th>
                            <th class="py-3">Commentaire</th>
                            <th class="py-3 text-center">Statut</th>
                            <th class="py-3 text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for visite in visites %}
                            <tr>
                                <td class="px-4 py-4">
                                    <i class="bi bi-calendar3 text-primary me-2"></i>
                                    <span class="fw-semibold">{{ visite.date|date('d/m/Y') }}</span>
                                    <small class="text-muted d-block ms-4">{{ visite.date|date('H:i') }}</small>
                                </td>
                                <td class="py-4">
                                    {% if visite.commentaire %}
                                        <span class="text-truncate d-inline-block" style="max-width: 300px;" title="{{ visite.commentaire }}">
                                            {{ visite.commentaire }}
                                        </span>
                                    {% else %}
                                        <span class="text-muted fst-italic">Pas de commentaire</span>
                                    {% endif %}
                                </td>
                                <td class="py-4 text-center">
                                    <form action="{{ path('visite_change_statut', {'id': visite.id}) }}" method="post">
                                        <select name="statut" onchange="this.form.submit()" class="form-select form-select-sm w-auto d-inline-block
                                            {% if visite.statut == 'prevue' %}border-warning text-warning{% endif %}
                                            {% if visite.statut == 'realisee' %}border-success text-success{% endif %}
                                            {% if visite.statut == 'annulee' %}border-danger text-danger{% endif %}">
                                            {% for s in ['prevue', 'realisee', 'annulee'] %}
                                                <option value="{{ s }}" {% if visite.statut == s %}selected{% endif %}>
                                                    {{ s|capitalize }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </form>
                                </td>
                                <td class="py-4 text-end pe-4">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-primary dropdown-toggle" 
                                                type="button" 
                                                id="dropdownVisiteActions{{ visite.id }}" 
                                                data-bs-toggle="dropdown" 
                                                aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical me-1"></i>Actions
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="dropdownVisiteActions{{ visite.id }}">
                                            <li>
                                                <a class="dropdown-item" href="{{ path('visite_compte_rendu', {'id': visite.id}) }}">
                                                    <i class="bi bi-file-text text-secondary me-2"></i>Voir le compte rendu
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a class="dropdown-item" href="{{ path('visite_edit', {'id': visite.id}) }}">
                                                    <i class="bi bi-pencil text-primary me-2"></i>Modifier
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form action="{{ path('visite_delete', {'id': visite.id}) }}" 
                                                      method="post" 
                                                      onsubmit="return confirm('Voulez-vous vraiment supprimer cette visite ?');">
                                                    <input type="hidden" name="_method" value="DELETE">
                                                    <button class="dropdown-item text-danger" type="submit">
                                                        <i class="bi bi-trash me-2"></i>Supprimer
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <i class="bi bi-calendar-x fs-1 text-muted d-block mb-3"></i>
                                    <p class="text-muted mb-3">Aucune visite pour cet étudiant</p>
                                    <a href="{{ path('visite_add', {'id': etudiant.id}) }}" class="btn btn-primary btn-sm">
                                        <i class="bi bi-plus-circle me-1"></i>Ajouter la première visite
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
{% endblock %}