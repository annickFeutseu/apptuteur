{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-5">
    <h2>Visites de {{ etudiant.prenom }} {{ etudiant.nom }}</h2>
    <a href="{{ path('visite_add', {'id': etudiant.id}) }}" class="btn btn-success mb-3">Ajouter une visite</a>

    {% include 'partials/visite/_filters.html.twig' with {
        statut: statut ?? 'Toutes',
        etudiant: etudiant
    } %}

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Commentaire</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for visite in visites %}
                <tr>
                    <td>{{ visite.date|date('d/m/Y H:i') }}</td>
                    <td>{{ visite.commentaire }}</td>
                    <td>
                        <form action="{{ path('visite_change_statut', {'id': visite.id}) }}" method="post">
                            <select name="statut" onchange="this.form.submit()" class="form-select form-select-sm">
                                {% for s in ['prevue', 'realisee', 'annulee'] %}
                                    <option value="{{ s }}" {% if visite.statut == s %}selected{% endif %}>
                                        {{ s|capitalize }}
                                    </option>
                                {% endfor %}
                            </select>
                        </form>
                    </td>
                    <td>
                        <a href="{{ path('visite_compte_rendu', {'id': visite.id}) }}" class="btn btn-secondary btn-sm">Compte rendu</a>
                        <a href="{{ path('visite_edit', {'id': visite.id}) }}" class="btn btn-primary btn-sm">Modifier</a>
                        {# Formulaire de suppression #}
                        <form action="{{ path('visite_delete', {'id': visite.id}) }}" method="post" style="display:inline;" onsubmit="return confirm('Voulez-vous vraiment supprimer cette visite ?');">
                            <input type="hidden" name="_method" value="DELETE">
                            <button class="btn btn-danger btn-sm" type="submit">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center">Aucune visite</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
