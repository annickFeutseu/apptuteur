<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Compte-rendu de visite</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 14px;
            line-height: 1.4;
            color: #333;
        }

        h1, h2 {
            text-align: center;
        }

        .header, .footer {
            width: 100%;
            text-align: center;
            position: fixed;
        }

        .header {
            top: 0;
        }

        .footer {
            bottom: 0;
            font-size: 12px;
            color: #666;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid #333;
            padding: 8px;
            text-align: left;
        }

        th {
            background-color: #f2f2f2;
        }

        .section {
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Compte-rendu de visite</h1>
    </div>
    <br/>
    <br/>
    <br/>

    <div class="section">
        <strong>Étudiant :</strong> {{ visite.etudiant.prenom }} {{ visite.etudiant.nom }}<br>
        <strong>Tuteur :</strong> {{ visite.tuteur.nom }} {{ visite.tuteur.prenom }}<br>
        <strong>Date de la visite :</strong> {{ visite.date|date('d/m/Y H:i') }}<br>
        <strong>Statut :</strong> {{ visite.statut|capitalize }}
    </div>

    <div class="section">
        <h2>Commentaire</h2>
        <p>{{ visite.commentaire }}</p>
    </div>

    {% if visite.compteRendu %}
        <div class="section">
            <h2>Compte-rendu</h2>
            <p>{{ visite.compteRendu }}</p>
        </div>
    {% endif %}

    <div class="footer">
        Généré le {{ "now"|date('d/m/Y H:i') }}
    </div>
</body>
</html>
