{% block body %}
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100 py-5">
            <div class="col-md-5 col-lg-4">
                <div class="card shadow-lg border-0">
                    <div class="card-body p-5">
                        <!-- Logo et titre -->
                        <div class="text-center mb-4">
                            <div class="mb-3">
                                <i class="bi bi-mortarboard-fill text-primary fs-1"></i>
                            </div>
                            <h2 class="fw-bold mb-2">Bon retour !</h2>
                            <p class="text-muted">Connectez-vous à votre compte</p>
                        </div>

                        <!-- Message d'erreur -->
                        {% if error %}
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-circle me-2"></i>{{ error }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endif %}

                        <!-- Formulaire -->
                        <form action="{{ path('app_login') }}" method="POST">
                            <div class="mb-3">
                                <label for="email" class="form-label fw-semibold">
                                    <i class="bi bi-envelope me-1"></i>Email
                                </label>
                                <input type="email" 
                                       name="email" 
                                       id="email" 
                                       class="form-control form-control-lg" 
                                       placeholder="exemple@email.com"
                                       required 
                                       autofocus>
                            </div>

                            <div class="mb-4">
                                <label for="password" class="form-label fw-semibold">
                                    <i class="bi bi-lock me-1"></i>Mot de passe
                                </label>
                                <input type="password" 
                                       name="password" 
                                       id="password" 
                                       class="form-control form-control-lg" 
                                       placeholder="••••••••"
                                       required>
                                <div class="text-end mt-2">
                                    <a href="#" class="text-decoration-none small text-muted">Mot de passe oublié ?</a>
                                </div>
                            </div>

                            <div class="d-grid mb-3">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>Se connecter
                                </button>
                            </div>

                            <div class="text-center">
                                <span class="text-muted">Pas encore de compte ?</span>
                                <a href="#" class="text-decoration-none fw-semibold">S'inscrire</a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Footer -->
                <div class="text-center mt-4 text-muted small">
                    <p class="mb-0">© 2024 AppTuteur. Tous droits réservés.</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}