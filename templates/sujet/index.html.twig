{% extends 'base.html.twig' %}

{% block title %}Sujets de stage{% endblock %}

{% block body %}
<div class="container my-5">
    
    {# En-tête #}
    <div class="row mb-4">
        <div class="col">
            <h1 class="fw-bold mb-2">
                <i class="bi bi-journal-text text-primary me-2"></i>
                Sujets de stage
            </h1>
            <p class="text-muted">Parcourez tous les sujets de stage disponibles</p>
        </div>
        <div class="col-auto align-self-end">
            <span class="badge bg-primary fs-6 px-3 py-2">
                {{ sujets|length }} sujet{{ sujets|length > 1 ? 's' : '' }}
            </span>
        </div>
    </div>

    {# Filtre par entreprise #}
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label fw-semibold small text-muted">
                            <i class="bi bi-building me-1"></i>Filtrer par entreprise
                        </label>
                        <select name="entreprise" class="form-select" onchange="this.form.submit()">
                            <option value="">📋 Toutes les entreprises</option>
                            {% for t in tuteurs %}
                                {% if t.entreprise %}
                                    <option value="{{ t.entreprise }}" {{ t.entreprise == entreprise ? 'selected' : '' }}>
                                        🏢 {{ t.entreprise }}
                                    </option>
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search me-2"></i>Filtrer
                        </button>
                    </div>
                </div>

                {# Badge de filtre actif #}
                {% if entreprise %}
                    <div class="mt-3">
                        <span class="badge bg-light text-dark border">
                            Filtre actif : <strong>{{ entreprise }}</strong>
                            <a href="{{ path('app_sujets') }}" class="text-dark ms-1">
                                <i class="bi bi-x-circle"></i>
                            </a>
                        </span>
                    </div>
                {% endif %}
            </form>
        </div>
    </div>

    {# Liste des sujets #}
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h5 class="mb-0">
                <i class="bi bi-list-ul text-primary me-2"></i>
                Liste des sujets
            </h5>
        </div>
        <div class="card-body p-0">
            {% if sujets is empty %}
                <div class="text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                    <p class="text-muted mb-0">
                        {% if entreprise %}
                            Aucun sujet trouvé pour l'entreprise <strong>{{ entreprise }}</strong>.
                        {% else %}
                            Aucun sujet de stage disponible pour le moment.
                        {% endif %}
                    </p>
                </div>
            {% else %}
                <div class="list-group list-group-flush">
                    {% for s in sujets %}
                        <div class="list-group-item list-group-item-action">
                            <div class="d-flex w-100 justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <h5 class="mb-2">
                                        <i class="bi bi-bookmark text-primary me-2"></i>
                                        {{ s.sujet }}
                                    </h5>
                                    <div class="mb-2">
                                        <span class="badge bg-light text-dark border me-2">
                                            <i class="bi bi-person me-1"></i>{{ s.etudiant }}
                                        </span>
                                        <span class="badge bg-light text-dark border me-2">
                                            <i class="bi bi-people me-1"></i>{{ s.tuteur }}
                                        </span>
                                        <span class="badge bg-primary">
                                            <i class="bi bi-building me-1"></i>{{ s.entreprise }}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

</div>
{% endblock %}